<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.vikiboy.imac5k.tblink</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/imac5k-tblinkd</string>
		<string>watch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/var/log/imac5k-tblink.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/imac5k-tblink.log</string>
</dict>
</plist>
